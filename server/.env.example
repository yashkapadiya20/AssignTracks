# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection. Local install on this PC uses port 2509; a default
# install (e.g. on EC2) uses 5432. Avoid @ : / in the password.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:2509/tracker

# Signs login tokens. Use a long random value, e.g. from: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

PORT=4000

# Optional: folder for uploaded submission files (default: server/uploads)
# UPLOAD_DIR=/home/ubuntu/tracker-uploads
